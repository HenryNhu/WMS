@model WMS_new.Models.User
@{
    Layout = null;
    ViewData["Title"] = "Chọn kho đang làm việc";
}

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WMS.styles.css" asp-append-version="true" />
    <link rel="icon" href="/images/logo.png" />
</head>
<body>
    <div class="container-fluid">
        <div style="text-align:center">
            <img src="/logo/logo.png" alt="Logo" width="75" style="margin:10px" />
            <h1>Chọn kho làm việc</h1>
        </div>
        <form asp-action="SelectWorkingWarehouse" method="post" class="row g-3">
            <div class="col-12">
                <label for="WarehouseId">Mã kho</label>
                <input type="number" name="warehouseId" id="WarehouseId" class="form-control" placeholder="Chọn kho làm việc" value="@Model.WarehouseIdWork" required />
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="col-12 alert alert-danger m-2">@ViewBag.ErrorMessage</div>
            }
            <div class="col-12">
                <button type="submit" class="btn btn-warning col-12">Vào kho</button>
            </div>
        </form>
    </div>

</body>
</html>