@model WMS_new.Models.User
@{
    ViewData["Title"] = "Đăng nhập";
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Login</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WMS.styles.css" asp-append-version="true" />
    <link rel="icon" href="/logo/logo.png" />
</head>
<body>
    <div class="container-fluid">
        <div style="text-align:center">
            <img src="/logo/logo.png" alt="Logo" width="75" style="margin:10px" />
            <h1>ĐĂNG NHẬP</h1>
        </div>
        <form asp-action="Login" method="post" class="row g-3">
            <div class="col-12">
                <label asp-for="UserId" for="inputUser" class="form-label"></label>
                <input asp-for="UserId" type="number" class="form-control" id="inputUser" placeholder="Tên đăng nhập">
            </div>
            <div class="col-12">
                <label asp-for="Password" for="inputPassword" class="form-label"></label>
                <input asp-for="Password" type="password" class="form-control" id="inputPassword" placeholder="Mật khẩu">
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
            {
                <div class="col-12 alert alert-danger m-2">@ViewBag.ErrorMessage</div>
            }
            <div class="col-12">
                <button type="submit" class="btn btn-primary col-12">Đăng nhập</button>
            </div>
        </form>
    </div>

</body>
</html>
